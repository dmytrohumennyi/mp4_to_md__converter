# =============================================================================
#  Lecture Converter — .gitignore
#
#  Єдине джерело правди — install.sh. Усе, що він генерує, з репозиторію
#  виключено: інакше згенеровані файли розходилися б з генератором, і
#  було б незрозуміло, яку з двох версій правити.
# =============================================================================

# --- Згенероване install.sh --------------------------------------------------
converter.py
converter.py.bak
converter.py.prevenv.bak
converter.env
requirements.txt
USAGE.md
assets/

# --- Середовище та кеш моделей -----------------------------------------------
# venv специфічний для машини; ваги Whisper важать до 3 ГБ і легко
# завантажуються повторно.
venv/
.venv/
env/
models/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Медіа та артефакти обробки ----------------------------------------------
# Записи лекцій не місце в git: гігабайти бінарних даних роздують історію
# безповоротно. Для великих файлів існує git-lfs, але й він тут зайвий.
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.mp3
*.wav
*.m4a
*.flac

# Транскрипти можна комітити свідомо: `git add -f lecture01.md`
# Типово ж вони лишаються локальними — часто містять непубличний матеріал.

# --- Редактори та ОС ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
